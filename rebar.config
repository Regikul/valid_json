{erl_opts, [debug_info]}.
{minimum_otp_vsn, "20"}.
{deps, []}.

{pre_hooks, [
    {compile, "escript tools/embed_json_schemas.escript"}
]}.

%% Команда `valid-json` собирается из того же приложения: escript'у нужны
%% только его beam-файлы, а метасхемы вшиты в модуль на этапе компиляции.
%% Главный модуль называется явно: по умолчанию rebar3 подставляет имя
%% приложения, а ввод-вывод фасаду не принадлежит.
{escript_name, "valid-json"}.
{escript_main_app, valid_json}.
{escript_emu_args, "%%! -escript main valid_json_cli +sbtu +A1\n"}.

{shell, [
    {config, "config/sys.config"}, % Path to your application's system configuration
    {apps, [valid_json]}       % Applications to auto-boot when starting the shell
]}.

{eunit_opts, [
    no_tty,
    {report, {valid_json_eunit_progress, [colored, {success_interval, 100}]}}
]}.

%% Отдельное имя для conformance-профилей: они и есть основная проверка
%% библиотеки, и запускать их хочется без остальных тестов.
{alias, [
    {conformance, [{eunit, "--module=valid_json_conformance,"
                           "valid_json_output_conformance"}]}
]}.

%% Профиль CI отличается только строгостью к предупреждениям: локально
%% предупреждение остаётся предупреждением, в CI становится отказом.
{profiles, [
    {ci, [{erl_opts, [debug_info, warnings_as_errors]}]}
]}.
