%% Конфигурация окружения разработки. `rebar3 shell` подхватывает
%% config/sys.config сам, отдельной записи в rebar.config для этого не нужно.
%%
%% Значения читаются один раз, при старте управляющего хранилищем, поэтому
%% менять их из уже поднятого shell поздно: нужен перезапуск приложения.
[
 {valid_json,
  [
   %% База, относительно которой разрешаются имена, переданные в add/2. Без неё
   %% стандартное хранилище принимает только абсолютные имена, а короткое вроде
   %% <<"allow">> отвергает с relative_uri_without_base. База обязана быть
   %% иерархической: URN здесь не годится.
   {base_uri, <<"https://example.com/">>}

   %% Загрузчик наполняет хранилище схемами при старте. Для стандартного
   %% хранилища это единственный способ его задать: его дерево поднимает сама
   %% библиотека, и опций ему передать неоткуда. Каталог называет и базу — своим
   %% `file://` URI, — поэтому вместе с загрузчиком base_uri выше обычно не
   %% нужен: он загрузчика как раз перебивает. Каталог называется либо прямо,
   %% `{root, Path}`, либо путём внутри `priv` приложения — второе не зависит от
   %% того, откуда запущен узел.
   %% {loader, {valid_json_loader_dir, [{priv_dir, valid_json, "schemas"}]}},

   %% Ниже — остальные опции хранилища с их встроенными умолчаниями. Они
   %% приведены как есть, чтобы было видно, что можно менять.
   %% {default_dialect, <<"https://json-schema.org/draft/2020-12/schema">>},
   %% {assert_format, false}
  ]}
].
